# ─────────────────────────────────────────────────────────────
# BearFit — environment variables
# Copy to .env.local and replace every placeholder value.
# ─────────────────────────────────────────────────────────────

# Public URL of the app (used for OAuth redirects & share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
# (legacy "anon" / "service_role" keys also work here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key

# Postgres connection for Prisma migrations (npm run db:deploy / db:new)
# Supabase → Connect → "Session pooler" (port 5432, works on IPv4 & Vercel)
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Cloudflare R2 → R2 → Manage API tokens (S3 compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=bearfit
# Public bucket URL (r2.dev subdomain or custom domain), no trailing slash
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Groq (vision model for calorie estimates)
GROQ_API_KEY=your-groq-api-key
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Shared secret between Supabase pg_cron and /api/cron/reminders
CRON_SECRET=your-random-cron-secret
